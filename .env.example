# Sanctum Canvas — local env example (no secrets)

# Auth (lab)
CANVAS_LAB_TOKEN=canvas-lab-dev
CANVAS_LAB_OWNER_ID=lab-owner
CANVAS_LAB_PROJECT_ID=lab-project
# Or JSON map: CANVAS_AUTH_TOKENS={"token":{"ownerId":"u1","projectId":"p1"}}

CANVAS_CSRF_SECRET=change-me-in-deploy
CANVAS_STORAGE_DRIVER=sqlite
# CANVAS_STORAGE_PATH=/path/to/var/storage

# Inference: fake (default) | fixture | venice
CANVAS_INFERENCE_PROVIDER=fake

# Venice — load from ~/.ssh/venice-api-moya.pass (do not put real keys here)
# VENICE_API_KEY=
# VENICE_INFERENCE_KEY=
# VENICE_API_BASE=https://api.venice.ai/api/v1
# VENICE_MODEL=venice-uncensored

CANVAS_STREAM_MAX_SECONDS=120
CANVAS_STREAM_MAX_BYTES=2000000
