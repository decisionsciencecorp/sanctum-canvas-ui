{
  "$defs": {
    "ObjBox": {
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "author": { "type": "string" },
            "views": { "type": "number" }
          },
          "required": ["author"]
        }
      },
      "required": []
    },
    "ArrBox": {
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number" }
            },
            "required": ["label"]
          }
        }
      },
      "required": []
    },
    "TagBox": {
      "properties": {
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": []
    },
    "EnumBox": {
      "properties": {
        "status": { "enum": ["active", "inactive"] }
      },
      "required": []
    },
    "AnyBox": {
      "properties": {
        "combo": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
      },
      "required": []
    },
    "ScalarBox": {
      "properties": {
        "title": { "type": "string" },
        "count": { "type": "number" },
        "flag": { "type": "boolean" }
      },
      "required": []
    },
    "ListBox": {
      "properties": { "children": { "type": "array" } },
      "required": []
    },
    "CardBox": {
      "properties": { "text": { "type": "string" } },
      "required": []
    },
    "ReqScalar": {
      "properties": { "title": { "type": "string" } },
      "required": ["title"]
    },
    "DefBox": {
      "properties": { "theme": { "type": "string", "default": "dark" } },
      "required": ["theme"]
    },
    "SlotBox": {
      "properties": {
        "children": {
          "type": "array",
          "items": { "anyOf": [{ "$ref": "#/$defs/CardBox" }] }
        }
      },
      "required": []
    },
    "ChartBox": {
      "properties": {
        "labels": { "type": "array", "items": { "type": "string" } },
        "variant": { "enum": ["grouped", "stacked"] }
      },
      "required": ["labels"]
    },
    "NestDefBox": {
      "properties": {
        "cfg": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "default": "fast" },
            "retries": { "type": "number", "default": 3 }
          },
          "required": ["mode"]
        }
      },
      "required": []
    }
  }
}
